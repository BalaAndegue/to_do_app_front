# URL de base de l'API backend (sans slash final)
# En développement : http://127.0.0.1:8000/api
# En production    : https://your-backend.com/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Cloudinary — upload de fichiers et images de couverture
# Créer un compte sur https://cloudinary.com puis récupérer ces valeurs
# dans Dashboard > Settings > Upload > Upload presets (unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
