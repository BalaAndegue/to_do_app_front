      summary: Lister les invitations en attente
      description: Retourne les invitations des tableaux que vous administrez. Pour
        inviter quelqu'un, utiliser **POST /boards/{id}/invite/**.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      responses:
        '200':
          description: ''
