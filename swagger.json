          schema:
            $ref: '#/definitions/BoardInvitation'
      tags:
      - Invitations
    delete:
      operationId: invitations_delete
      summary: Annuler une invitation
      description: Supprime l'invitation. L'email invité ne pourra plus accepter le
        token.
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Invitations
    parameters:
    - name: id
      in: path
      required: true
      type: string
