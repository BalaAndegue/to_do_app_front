  /login/:
    post:
      operationId: login_create
      summary: Se connecter
      description: |-
        Authentifie l'utilisateur avec **email** + **password** et retourne le token.

        Inclure ce token dans toutes les requêtes suivantes :
        `Authorization: Token <token>`
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Login'
      responses:
        '200':
          description: Connexion réussie — token retourné.
          examples:
            application/json:
              success: true
              message: Connexion réussie.
              data:
                token: <token>
                user: {}
        '400':
          description: Email ou mot de passe invalide.
      tags:
      - Authentification
    parameters: []
  /logout/:
    post:
      operationId: logout_create
      summary: Se déconnecter
      description: Invalide le token d'authentification courant. L'utilisateur doit
        se reconnecter pour obtenir un nouveau token.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          type: object
          properties: {}
      responses:
        '200':
          description: Déconnexion réussie.
        '400':
          description: Aucun token actif.
      tags:
      - Authentification
    parameters: []
  /register/:
    post:
      operationId: register_create
      summary: Créer un compte utilisateur
      description: |-
        Enregistre un nouvel utilisateur et retourne immédiatement un token d'authentification.

        Champs requis : **username**, **email**, **password**.
        Champs optionnels : **first_name**, **last_name**, **bio**, **avatar_url**.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/User'
      responses:
        '201':
          description: Compte créé — token retourné.
          examples:
            application/json:
              success: true
              message: Compte créé avec succès.
              data:
                token: <token>
                user: {}
        '400':
          description: Erreur de validation (email ou username déjà utilisé, mot de
            passe trop faible…)
      tags:
      - Authentification
    parameters: []
