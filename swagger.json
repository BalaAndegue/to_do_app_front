swagger: '2.0'
info:
  title: Collaborative Workspace API
  description: |-
    REST API for a Trello-like collaborative workspace.

    **Authentication** — All endpoints (except `/register/` and `/login/`) require a token:
    ```
    Authorization: Token <your_token>
    ```

    **Key resources:** Boards → Lists → Cards → Checklists / Labels / Comments / Attachments

    **Roles:** Each board has members with roles `admin`, `member`, or `observer`.
  termsOfService: https://www.example.com/terms/
  contact:
    email: contact@example.com
  license:
    name: MIT License
  version: v1
host: localhost:8000
schemes:
- http
basePath: /api
consumes:
- application/json
produces:
- application/json
securityDefinitions:
  Token:
    type: apiKey
    in: header
    name: Authorization
    description: 'Format : Token <votre_token>'
security:
- Token: []
paths:
  /activities/:
    get:
      operationId: activities_list
      summary: Fil d'activité
      description: |-
        Retourne le journal des actions sur les tableaux accessibles, trié du plus récent au plus ancien. Les activités sont créées **automatiquement** par les signaux Django — cet endpoint est en **lecture seule**.

        **Types d'action :** `create_board`, `join_board`, `leave_board`, `add_comment`, `delete_comment`, `check_item`, `uncheck_item`.

        Filtres : **?board=<id>** ou **?card=<id>**.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: board
        in: query
        description: Filtrer par tableau (board_id).
        type: integer
      - name: card
        in: query
        description: Filtrer par carte (card_id).
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/Activity'
      tags:
      - Activity
    parameters: []
  /activities/{activity_id}/:
    get:
      operationId: activities_read
      summary: Détail d'une entrée d'activité
      description: ''
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Activity'
      tags:
      - Activity
    parameters:
    - name: activity_id
      in: path
      required: true
      type: string
  /attachments/:
    get:
      operationId: attachments_list
      summary: Lister les pièces jointes
      description: Retourne les pièces jointes des cartes accessibles. Utiliser **?card=<id>**.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: card
        in: query
        description: Filtrer par carte (card_id).
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/Attachment'
      tags:
      - Attachments
    post:
      operationId: attachments_create
      summary: Enregistrer une pièce jointe
      description: 'Enregistre les métadonnées d''un fichier déjà hébergé (S3, Cloudinary…).
        Le champ **uploaded_by** est automatiquement défini sur l''utilisateur connecté.
        Fournir : **card**, **filename**, **url**, **mime_type**, **size** (en octets).'
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Attachment'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/Attachment'
      tags:
      - Attachments
    parameters: []
  /attachments/{attach_id}/:
    get:
      operationId: attachments_read
      summary: Détail d'une pièce jointe
      description: ''
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Attachment'
      tags:
      - Attachments
    put:
      operationId: attachments_update
      summary: Remplacer les métadonnées d'une pièce jointe
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Attachment'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Attachment'
      tags:
      - Attachments
    patch:
      operationId: attachments_partial_update
      summary: Modifier partiellement les métadonnées d'une pièce jointe
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Attachment'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Attachment'
      tags:
      - Attachments
    delete:
      operationId: attachments_delete
      summary: Supprimer une pièce jointe
      description: Réservé au déposant ou à un admin du tableau.
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Attachments
    parameters:
    - name: attach_id
      in: path
      required: true
      type: string
  /board-members/:
    get:
      operationId: board-members_list
      summary: Lister les membres des tableaux
      description: Retourne tous les membres des tableaux auxquels l'utilisateur appartient.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/BoardMember'
      tags:
      - Board Members
    post:
      operationId: board-members_create
      summary: Ajouter un membre directement
      description: Ajoute un utilisateur comme membre d'un tableau sans passer par
        une invitation. Requiert le rôle **admin**. Préférer **POST /boards/{id}/invite/**
        pour envoyer un email.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/BoardMember'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/BoardMember'
      tags:
      - Board Members
    parameters: []
  /board-members/{id}/:
    get:
      operationId: board-members_read
      summary: Détail d'un membre
      description: ''
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/BoardMember'
      tags:
      - Board Members
    put:
      operationId: board-members_update
      summary: Remplacer le rôle d'un membre (remplacement complet)
      description: Requiert le rôle **admin** sur le tableau.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/BoardMember'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/BoardMember'
      tags:
      - Board Members
    patch:
      operationId: board-members_partial_update
      summary: Changer le rôle d'un membre
      description: Change le rôle d'un membre (`admin`, `member`, `observer`). Requiert
        le rôle **admin** sur le tableau.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/BoardMember'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/BoardMember'
      tags:
      - Board Members
    delete:
      operationId: board-members_delete
      summary: Retirer un membre du tableau
      description: Requiert le rôle **admin** sur le tableau.
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Board Members
    parameters:
    - name: id
      in: path
      required: true
      type: string
  /boards/:
    get:
      operationId: boards_list
      summary: Lister les tableaux accessibles
      description: Retourne tous les tableaux publics + les tableaux dont l'utilisateur
        est membre ou créateur. Résultats paginés (20/page).
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: is_closed
        in: query
        description: Filtrer les tableaux archivés (true) ou actifs (false).
        type: boolean
      - name: visibility
        in: query
        description: Filtrer par visibilité.
        type: string
        enum:
        - public
        - private
        - workspace
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/BoardList'
      tags:
      - Boards
    post:
      operationId: boards_create
      summary: Créer un tableau
      description: Crée un nouveau tableau. Le créateur est automatiquement ajouté
        comme membre avec le rôle **admin**.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Board'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/Board'
      tags:
      - Boards
    parameters: []
  /boards/{board_id}/:
    get:
      operationId: boards_read
      summary: Détail d'un tableau
      description: Retourne le tableau avec ses listes (résumé) et la liste de ses
        membres.
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Board'
      tags:
      - Boards
    put:
      operationId: boards_update
      summary: Mettre à jour un tableau (remplacement complet)
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Board'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Board'
      tags:
      - Boards
    patch:
      operationId: boards_partial_update
      summary: Mettre à jour un tableau (partiel)
      description: Met à jour un ou plusieurs champs du tableau.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Board'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Board'
      tags:
      - Boards
    delete:
      operationId: boards_delete
      summary: Supprimer un tableau
      description: Supprime définitivement le tableau et tout son contenu (listes,
        cartes, etc.).
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Boards
    parameters:
    - name: board_id
      in: path
      required: true
      type: string
  /boards/{board_id}/close/:
    post:
      operationId: boards_close
      summary: Archiver (fermer) un tableau
      description: Marque le tableau comme fermé. Requiert le rôle **admin**.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          type: object
          properties: {}
      responses:
        '200':
          description: Tableau archivé.
        '403':
          description: Permission refusée.
      tags:
      - Boards
    parameters:
    - name: board_id
      in: path
      required: true
      type: string
  /boards/{board_id}/invite/:
    post:
      operationId: boards_invite
      summary: Inviter un utilisateur par email
      description: Crée une invitation avec un token UUID unique et envoie un email
        à l'adresse indiquée. Requiert le rôle **admin** sur le tableau.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - email
          type: object
          properties:
            email:
              description: Email de l'utilisateur à inviter.
              type: string
              format: email
            role:
              description: Rôle attribué à l'invité.
              type: string
              enum:
              - member
              - observer
              default: member
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/BoardInvitation'
        '400':
          description: Email manquant, utilisateur déjà membre, ou invitation déjà
            en attente.
      tags:
      - Boards
    parameters:
    - name: board_id
      in: path
      required: true
      type: string
  /boards/{board_id}/members/:
    get:
      operationId: boards_members
      summary: Lister les membres du tableau
      description: Retourne tous les membres avec leur rôle et la date d'adhésion.
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            type: array
            items:
              $ref: '#/definitions/BoardMember'
      tags:
      - Boards
    parameters:
    - name: board_id
      in: path
      required: true
      type: string
  /boards/{board_id}/reopen/:
    post:
      operationId: boards_reopen
      summary: Réouvrir un tableau archivé
      description: Restaure un tableau fermé. Requiert le rôle **admin**.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          type: object
          properties: {}
      responses:
        '200':
          description: Tableau réouvert.
        '403':
          description: Permission refusée.
      tags:
      - Boards
    parameters:
    - name: board_id
      in: path
      required: true
      type: string
  /card-labels/:
    get:
      operationId: card-labels_list
      summary: Lister les associations carte-label
      description: Retourne les labels appliqués aux cartes accessibles. Utiliser
        **?card=<id>**.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: card
        in: query
        description: Filtrer par carte (card_id).
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/CardLabel'
      tags:
      - Card Labels
    post:
      operationId: card-labels_create
      summary: Appliquer un label à une carte
      description: Associe un label existant à une carte. Le label doit appartenir
        au même tableau que la carte.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardLabel'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/CardLabel'
      tags:
      - Card Labels
    parameters: []
  /card-labels/{id}/:
    get:
      operationId: card-labels_read
      summary: Détail d'une association carte-label
      description: ''
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardLabel'
      tags:
      - Card Labels
    put:
      operationId: card-labels_update
      summary: Remplacer une association carte-label
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardLabel'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardLabel'
      tags:
      - Card Labels
    patch:
      operationId: card-labels_partial_update
      summary: Modifier partiellement une association carte-label
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardLabel'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardLabel'
      tags:
      - Card Labels
    delete:
      operationId: card-labels_delete
      summary: Retirer un label d'une carte
      description: Supprime l'association. Le label du tableau n'est pas supprimé.
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Card Labels
    parameters:
    - name: id
      in: path
      required: true
      type: string
  /card-members/:
    get:
      operationId: card-members_list
      summary: Lister les membres assignés aux cartes
      description: Retourne les assignations des cartes accessibles. Utiliser **?card=<id>**.
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: card
        in: query
        description: Filtrer par carte (card_id).
        type: integer
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/CardMember'
      tags:
      - Card Members
    post:
      operationId: card-members_create
      summary: Assigner un membre à une carte
      description: Assigne un utilisateur à une carte. L'utilisateur doit être membre
        du tableau contenant la carte.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardMember'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/CardMember'
      tags:
      - Card Members
    parameters: []
  /card-members/{id}/:
    get:
      operationId: card-members_read
      summary: Détail d'une assignation
      description: ''
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardMember'
      tags:
      - Card Members
    put:
      operationId: card-members_update
      summary: Remplacer une assignation
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardMember'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardMember'
      tags:
      - Card Members
    patch:
      operationId: card-members_partial_update
      summary: Modifier partiellement une assignation
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/CardMember'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/CardMember'
      tags:
      - Card Members
    delete:
      operationId: card-members_delete
      summary: Retirer un membre d'une carte
      description: Désassigne l'utilisateur de la carte. L'utilisateur reste membre
        du tableau.
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Card Members
    parameters:
    - name: id
      in: path
      required: true
      type: string
  /cards/:
    get:
      operationId: cards_list
      summary: Lister les cartes accessibles
      description: 'Retourne les cartes des tableaux accessibles. Filtres disponibles
        : **?list**, **?board**, **?archived**, **?search**.'
      parameters:
      - name: page
        in: query
        description: A page number within the paginated result set.
        required: false
        type: integer
      - name: list
        in: query
        description: Filtrer par liste (list_id).
        type: integer
      - name: board
        in: query
        description: Filtrer par tableau (board_id).
        type: integer
      - name: archived
        in: query
        description: true = cartes archivées, false = actives.
        type: boolean
      - name: search
        in: query
        description: Recherche plein-texte sur le titre et la description.
        type: string
      responses:
        '200':
          description: ''
          schema:
            required:
            - count
            - results
            type: object
            properties:
              count:
                type: integer
              next:
                type: string
                format: uri
                x-nullable: true
              previous:
                type: string
                format: uri
                x-nullable: true
              results:
                type: array
                items:
                  $ref: '#/definitions/Card'
      tags:
      - Cards
    post:
      operationId: cards_create
      summary: Créer une carte
      description: Crée une carte dans une liste. Le champ **board** est déduit automatiquement
        depuis la liste — inutile de le fournir.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Card'
      responses:
        '201':
          description: ''
          schema:
            $ref: '#/definitions/Card'
      tags:
      - Cards
    parameters: []
  /cards/{card_id}/:
    get:
      operationId: cards_read
      summary: Détail complet d'une carte
      description: 'Retourne la carte avec : labels, membres assignés, checklists
        (avec items et progression), pièces jointes, et le nombre de commentaires.'
      parameters: []
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Card'
      tags:
      - Cards
    put:
      operationId: cards_update
      summary: Mettre à jour une carte (remplacement complet)
      description: ''
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Card'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Card'
      tags:
      - Cards
    patch:
      operationId: cards_partial_update
      summary: Modifier partiellement une carte
      description: 'Met à jour un ou plusieurs champs : titre, description, due_date,
        cover_image_url, etc.'
      parameters:
      - name: data
        in: body
        required: true
        schema:
          $ref: '#/definitions/Card'
      responses:
        '200':
          description: ''
          schema:
            $ref: '#/definitions/Card'
      tags:
      - Cards
    delete:
      operationId: cards_delete
      summary: Supprimer définitivement une carte
      description: Supprime la carte et tout son contenu (checklists, commentaires,
        pièces jointes).
      parameters: []
      responses:
        '204':
          description: ''
      tags:
      - Cards
    parameters:
    - name: card_id
      in: path
      required: true
      type: string
  /cards/{card_id}/archive/:
    post:
      operationId: cards_archive
      summary: Archiver une carte (soft delete)
      description: Masque la carte sans la supprimer. Récupérable via **unarchive**.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          type: object
          properties: {}
      responses:
        '200':
          description: Carte archivée.
      tags:
      - Cards
    parameters:
    - name: card_id
      in: path
      required: true
      type: string
  /cards/{card_id}/move/:
    post:
      operationId: cards_move
      summary: Déplacer une carte
      description: Change la position d'une carte dans sa liste ou la déplace dans
        une autre liste du même tableau. Utiliser un **PATCH** standard pour modifier
        les champs de la carte.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - position
          type: object
          properties:
            position:
              description: Nouvelle position (index 0) dans la liste.
              type: integer
            list_id:
              description: ID de la liste cible (optionnel, même tableau uniquement).
              type: integer
