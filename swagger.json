    parameters: []
  /users/change_password/:
    post:
      operationId: users_change_password
      summary: Changer son mot de passe
      description: Change le mot de passe de l'utilisateur connecté. Le token actuel
        est invalidé et un nouveau token est retourné. Le frontend doit stocker le
        nouveau token et l'utiliser pour les requêtes suivantes.
      parameters:
      - name: data
        in: body
        required: true
        schema:
          required:
          - new_password
          type: object
          properties:
            new_password:
              description: Nouveau mot de passe (soumis aux validateurs Django).
              type: string
      responses:
        '200':
          description: Mot de passe changé — nouveau token retourné.
          examples:
            application/json:
              success: true
              message: Mot de passe mis à jour. Reconnectez-vous avec votre nouveau
                token.
              data:
                token: <new_token>
        '400':
          description: Mot de passe invalide ou non fourni.
      tags:
      - Utilisateurs
    parameters: []
